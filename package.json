{
  "name": "techpick",
  "private": true,
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @techpick/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @techpick/db generate",
    "db:migrate": "pnpm --filter @techpick/db migrate",
    "db:seed": "pnpm --filter @techpick/db seed"
  }
}
